# Backend-local overrides. Shared Supabase credentials live in ../.env
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=INFO
CORS_ORIGINS=["http://localhost:3000"]

# Optional: bypass the SUPABASE_* settings with an explicit connection string.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
# MIGRATION_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres

DB_SSL=true
DB_ECHO=false
# Alembic owns the schema; true is only for throwaway experiments
AUTO_CREATE_TABLES=false
