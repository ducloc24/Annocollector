# Supabase — Project Settings → Database → Connection string
# The app uses the transaction pooler (6543); migrations use the session
# pooler (5432) because that mode is recommended for DDL.
SUPABASE_HOST=aws-0-eu-west-1.pooler.supabase.com
SUPABASE_PORT=6543
SUPABASE_DB=postgres
SUPABASE_USER=postgres.<project-ref>
SUPABASE_PASSWORD=<your-database-password>
SUPABASE_MIGRATION_PORT=5432

# Optional: override the whole connection string instead of the parts above.
# DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
# MIGRATION_DATABASE_URL=postgresql+asyncpg://user:password@host:5432/postgres
